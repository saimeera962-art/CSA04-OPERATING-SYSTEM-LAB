#include <stdio.h>
#include <stdlib.h>

int main()
{
    FILE *fp;
    char data[100];

    fp = fopen("file.txt", "w");

    if (fp == NULL)
    {
        printf("Unable to create file\n");
        return 1;
    }

    fprintf(fp, "Operating System File Management");
    fclose(fp);

    fp = fopen("file.txt", "r");

    if (fp == NULL)
    {
        printf("Unable to open file\n");
        return 1;
    }

    fgets(data, sizeof(data), fp);

    printf("File Content: %s\n", data);

    fclose(fp);

    printf("File created, written, read and closed successfully.\n");

    return 0;
}
