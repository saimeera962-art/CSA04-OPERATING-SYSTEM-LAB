#include <stdio.h>
#include <string.h>

int main() {
    char pattern[100], filename[100];
    char line[500];
    FILE *fp;

    printf("Enter pattern to search: ");
    scanf("%s", pattern);

    printf("Enter file name: ");
    scanf("%s", filename);

    fp = fopen(filename, "r");

    if (fp == NULL) {
        perror("Unable to open file");
        return 1;
    }

    printf("\nMatching lines:\n");

    while (fgets(line, sizeof(line), fp) != NULL) {
        if (strstr(line, pattern) != NULL) {
            printf("%s", line);
        }
    }

    fclose(fp);

    return 0;
}
