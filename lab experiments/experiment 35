#include <stdio.h>

int main() {
    int indexBlock;
    int n;
    int blocks[50];
    int used[100] = {0};
    int i;

    printf("Enter index block: ");
    scanf("%d", &indexBlock);

    printf("Enter number of file blocks: ");
    scanf("%d", &n);

    if (indexBlock < 0 || indexBlock >= 100) {
        printf("Invalid index block.\n");
        return 0;
    }

    used[indexBlock] = 1;

    printf("Enter %d data block numbers:\n", n);

    for (i = 0; i < n; i++) {
        scanf("%d", &blocks[i]);

        if (blocks[i] < 0 || blocks[i] >= 100 ||
            used[blocks[i]]) {
            printf("Invalid or already allocated block.\n");
            return 0;
        }

        used[blocks[i]] = 1;
    }

    printf("\nIndex Block: %d\n", indexBlock);

    printf("Index Table:\n");

    for (i = 0; i < n; i++)
        printf("Entry %d -> Block %d\n", i + 1, blocks[i]);

    return 0;
}
