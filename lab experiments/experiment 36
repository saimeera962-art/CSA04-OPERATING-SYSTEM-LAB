#include <stdio.h>

int main() {
    int disk[100] = {0};
    int next[100];
    int n;
    int blocks[50];
    int i;

    printf("Enter number of blocks required: ");
    scanf("%d", &n);

    printf("Enter %d disk blocks:\n", n);

    for (i = 0; i < n; i++) {
        scanf("%d", &blocks[i]);

        if (blocks[i] < 0 || blocks[i] >= 100) {
            printf("Invalid block number.\n");
            return 0;
        }

        if (disk[blocks[i]] == 1) {
            printf("Block %d already allocated.\n", blocks[i]);
            return 0;
        }

        disk[blocks[i]] = 1;
    }

    for (i = 0; i < n - 1; i++)
        next[blocks[i]] = blocks[i + 1];

    next[blocks[n - 1]] = -1;

    printf("\nFile allocated using linked allocation.\n");

    printf("Start Block: %d\n", blocks[0]);
    printf("End Block: %d\n", blocks[n - 1]);

    printf("\nBlock Chain:\n");

    for (i = 0; i < n; i++) {
        printf("%d -> %d\n", blocks[i], next[blocks[i]]);
    }

    return 0;
}
